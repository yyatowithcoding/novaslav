# Copy this file to .env and fill in real values. Never commit the real .env.

# Discord bot token (Discord Developer Portal > your app > Bot > Reset Token).
# Leave blank to run the HTTP relay without logging into Discord.
DISCORD_BOT_TOKEN=

# Your MongoDB Atlas (or self-hosted) connection string.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DB=novaslav

# Shared secret the Cloudflare Pages Function must send as
# "Authorization: Bearer <RELAY_SECRET>". Make this a long random string.
RELAY_SECRET=change-me-to-a-long-random-string

# Port the aiohttp server listens on.
RELAY_PORT=8787
